# Copia este archivo como .env.local y rellena los valores del proyecto.
# .env.local nunca se commitea (está en .gitignore).

# Supabase — Project Settings > API en el proyecto del cliente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nombre visible del cliente/pyme (aparece en el login)
NEXT_PUBLIC_APP_NOMBRE=Mi App

# ─────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY va a propósito FUERA de este archivo.
#
# Esa llave se salta la RLS por completo: quien la tiene lee y escribe
# los datos de todas las empresas sin restricción. El template no la
# necesita — todo el acceso a datos va con la anon key + RLS.
#
# Si un proyecto llega a requerirla (algún job administrativo), se agrega
# ahí, nunca con prefijo NEXT_PUBLIC_ (eso la mandaría al navegador), y
# usándola solo en código de servidor.
# ─────────────────────────────────────────────────────────────────────
